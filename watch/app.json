{
  "configVersion": "v3",
  "app": {
    "appId": 20004,
    "appName": "Code Blue Helper",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "0.1.0"
    },
    "icon": "icon.png",
    "vender": "rizqanfahlevvi",
    "description": "Timer and action recorder for cardiac arrest resuscitation"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.0",
      "minVersion": "3.0"
    }
  },
  "debug": false,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/gt/home/index.page",
            "page/gt/code/index.page",
            "page/gt/summary/index.page",
            "page/gt/detail/index.page",
            "page/gt/history/index.page",
            "page/gt/credit/index.page"
          ]
        },
        "app-widget": {
          "widgets": [
            {
              "path": "app-widget/index",
              "icon": "icon.png",
              "name": "Code Blue",
              "runtime": {
                "type": "js"
              }
            }
          ]
        }
      },
      "platforms": [
        {
          "st": "r"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Code Blue Helper",
      "app-widget": {
        "widgets": [
          {
            "name": "Code Blue"
          }
        ]
      }
    },
    "id-ID": {
      "appName": "Code Blue Helper",
      "app-widget": {
        "widgets": [
          {
            "name": "Code Blue"
          }
        ]
      }
    }
  },
  "defaultLanguage": "en-US"
}
